{"openapi":"3.1.0","info":{"title":"OpenAPI definition","version":"v0"},"servers":[{"url":"http://api-lyrics.simpmusic.org","description":"Generated server url"}],"paths":{"/v1":{"post":{"tags":["Lyrics"],"summary":"Create New Lyric","description":"Creates a new lyric entry with the provided lyric data.","operationId":"createLyric","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/LyricRequestDTO"}}},"required":true},"responses":{"201":{"description":"Successfully created lyric","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocsLyricResponseSuccess"}}}},"400":{"description":"Bad request - Invalid lyric data","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocsErrorResponse"}}}},"409":{"description":"Conflict - This lyric already exists (duplicate SHA256 hash)","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocsErrorResponse"}}}},"500":{"description":"Internal server error occurred while creating lyric","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocsErrorResponse"}}}}}}},"/v1/vote":{"post":{"tags":["Lyrics"],"summary":"Vote for a Lyric","description":"Allows users to vote for a lyric by its ID. Returns the updated lyric data.","operationId":"voteLyric","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/VoteRequestDTO"}}},"required":true},"responses":{"200":{"description":"Successfully voted for lyric","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocsLyricResponseSuccess"}}}},"404":{"description":"Lyric not found with the given ID","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocsErrorResponse"}}}},"500":{"description":"Internal server error occurred while processing the vote","content":{"application/json":{"schema":{"$ref":"#/components/schemas/DocsErrorResponse"}}}}}}},"/v1/translated":{"post":{"tags":["Translated Lyrics"],"summary":"Create New Translated